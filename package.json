{
  "name": "wfjson-workflow",
  "version": "0.1.0",
  "description": "用 wfjson 记录工作流树与节点纪要的 Obsidian 插件（纯 TS 引擎 + dataviewjs 笔记视图）",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "test": "node --test \"src/engine/**/*.test.ts\" \"views/emoWidget.test.ts\" \"views/quadrantWidget.test.ts\" \"views/plotWidget.test.ts\"",
    "test:views": "node --import ./views/obsidianResolve.mjs --test \"views/wfView.test.ts\"",
    "deploy": "node scripts/deploy.mjs",
    "deploy:enable": "node scripts/deploy.mjs --enable",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "workflow",
    "wfjson",
    "dataviewjs"
  ],
  "author": "yjm",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.15.3",
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "typescript": "^5.8.3"
  }
}
